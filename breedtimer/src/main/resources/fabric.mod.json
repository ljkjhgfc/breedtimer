  "icon": "assets/breedtimer/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.breedtimer.client.BreedTimerClient"
    ]
  },
  "mixins": [
    "breedtimer.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.5",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "java": ">=21"
  }
